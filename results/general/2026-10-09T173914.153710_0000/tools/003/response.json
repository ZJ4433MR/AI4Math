ainty bounds. Role of projection operators in modifying the Cauchy\u2013Schwarz relation is noted. Selected applications reveal the efficacy.\r\nQuanta 2019; 8: 36-43.<\/jats:p>","DOI":"10.12743\/quanta.v8i1.90","type":"journal-article","created":{"date-parts":[[2019,8,3]],"date-time":"2019-08-03T17:50:32Z","timestamp":1564854632000},"page":"36-43","source":"Crossref","is-referenced-by-count":0,"title":["Improving the Cauchy-Schwarz inequality"],"prefix":"10.12743","volume":"8","author":[{"given":"Kamal","family":"Bhattacharyya","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"4996","published-online":{"date-parts":[[2019,8,4]]},"container-title":["Quanta"],"link":[{"URL":"https:\/\/dankogeorgiev.com\/ojs\/index.php\/quanta\/article\/download\/47\/47","content-type":"application\/pdf","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/dankogeorgiev.com\/ojs\/index.php\/quanta\/article\/download\/47\/47","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"deposited":{"date-parts":[[2025,7,26]],"date-time":"2025-07-26T15:16:23Z","timestamp":1753542983000},"score":31.809647,"resource":{"primary":{"URL":"https:\/\/dankogeorgiev.com\/ojs\/index.php\/quanta\/article\/view\/47"}},"issued":{"date-parts":[[2019,8,4]]},"references-count":0,"URL":"https:\/\/doi.org\/10.12743\/quanta.v8i1.90","ISSN":["1314-7374"],"issn-type":[{"type":"electronic","value":"1314-7374"}],"published":{"date-parts":[[2019,8,4]]}},{"indexed":{"date-parts":[[2025,11,19]],"date-time":"2025-11-19T02:42:00Z","timestamp":1763520120431,"version":"3.45.0"},"reference-count":11,"publisher":"Hans Publishers","issue":"02","content-domain":{"domain":[],"crossmark-restriction":false},"short-container-title":["PM"],"published-print":{"date-parts":[[2022]]},"DOI":"10.12677\/pm.2022.122036","type":"journal-article","created":{"date-parts":[[2022,2,24]],"date-time":"2022-02-24T20:28:41Z","t